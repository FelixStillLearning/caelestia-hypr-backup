#!/usr/bin/env python3
"""Tema GRUB bergaya Caelestia: latar wallpaper diburamkan, pertanyaan
dalam serif miring (New York), menu sans (SF Pro) tanpa kartu, pilihan berupa pill kaca.
Warna dan wallpaper diambil dari Caelestia.
Font .pf2 dimuat GRUB lewat grub.cfg: setelah nama font berubah, jalankan sudo grub-mkconfig -o /boot/grub/grub.cfg.

  sudo caelestia-grub-theme      buat/perbarui /boot/grub/themes/caelestia
  (dipanggil otomatis lewat postHook Caelestia setiap ganti wallpaper)

Gambar dibuat sebagai user biasa (sudo -u), root hanya menyalin hasil yang sudah
dicek ke /boot, jadi file milik user tidak pernah dibuka oleh root."""
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

DEST = Path("/boot/grub/themes/caelestia")
APPLE = Path("/usr/share/fonts/apple-fonts")
FONTS = {  # nama berkas pf2 -> (font sumber, nama keluarga di GRUB, ukuran)
    "caelestia-serif-40.pf2": ("NewYorkLarge-MediumItalic.otf", "Caelestia Serif", 40),
    "caelestia-sans-20.pf2": ("SF-Pro-Text-Regular.otf", "Caelestia Sans", 20),
    "caelestia-sans-medium-20.pf2": ("SF-Pro-Text-Medium.otf", "Caelestia Sans Medium", 20),
    "caelestia-sans-16.pf2": ("SF-Pro-Text-Regular.otf", "Caelestia Sans", 16),
    # terminal GRUB (teks "Loading Linux ..."): GRUB memakai font yang terakhir dimuat sebagai cadangan,
    # dan grub.cfg memuat font tema urut nama berkas, jadi nama ini sengaja paling akhir (t > s)
    "caelestia-terminal-18.pf2": ("/usr/share/fonts/TTF/JetBrainsMono-Regular.ttf", "Caelestia Mono", 18),
}
W, H = 1920, 1200
SLICES = ("nw", "n", "ne", "w", "c", "e", "sw", "s", "se")
OUTPUTS = ["theme.txt", "background.jpg"] + [f"select_{s}.png" for s in SLICES] + list(FONTS)
MAX_BYTES = 20 * 1024 * 1024


def box(prefix, out, rgba, r, rim=None):
    """9-slice kotak membulat (radius r) untuk pill GRUB, opsional dengan tepi 1 px."""
    from PIL import Image, ImageDraw

    s = 4  # supersampling biar tepi halus
    big = Image.new("RGBA", (2 * r * s + s, 2 * r * s + s), (0, 0, 0, 0))
    ImageDraw.Draw(big).rounded_rectangle((0, 0, big.width - 1, big.height - 1), r * s, fill=rgba,
                                          outline=rim, width=s if rim else 0)
    full = big.resize((2 * r + 1, 2 * r + 1), Image.LANCZOS)
    cuts = {
        "nw": (0, 0, r, r), "n": (r, 0, r + 1, r), "ne": (r + 1, 0, 2 * r + 1, r),
        "w": (0, r, r, r + 1), "c": (r, r, r + 1, r + 1), "e": (r + 1, r, 2 * r + 1, r + 1),
        "sw": (0, r + 1, r, 2 * r + 1), "s": (r, r + 1, r + 1, 2 * r + 1), "se": (r + 1, r + 1, 2 * r + 1, 2 * r + 1),
    }
    for name, c in cuts.items():
        full.crop(c).save(out / f"{prefix}_{name}.png")


def render(out: Path):
    from PIL import Image, ImageChops, ImageFilter, ImageOps

    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "caelestia"
    c = json.loads((state / "scheme.json").read_text())["colours"]
    col = {k: v for k, v in c.items() if re.fullmatch(r"[0-9a-fA-F]{6}", str(v))}
    rgb = lambda k: tuple(int(col[k][i:i + 2], 16) for i in (0, 2, 4))
    hexc = lambda k: "#" + col[k]

    # latar: wallpaper diburamkan + digelapkan, seperti lock screen Caelestia
    try:
        wall = ImageOps.fit(Image.open(state / "wallpaper/current").convert("RGB"), (W, H), Image.LANCZOS)
        wall = wall.filter(ImageFilter.GaussianBlur(40))
        # cukup gelap supaya teks putih terbaca juga di wallpaper terang
        wall = Image.blend(wall, Image.new("RGB", (W, H), rgb("surface")), 0.66)
    except (OSError, ValueError):
        wall = Image.new("RGB", (W, H), rgb("surface"))
    # tepi layar lebih gelap, perhatian ke tengah
    edge = Image.radial_gradient("L").resize((W, H), Image.BICUBIC).point(lambda v: int(v * 0.55))
    wall = Image.composite(Image.new("RGB", (W, H), rgb("surface")), wall, edge)
    # butiran halus supaya gradasi blur tidak membentuk garis-garis (banding)
    grain = Image.merge("RGB", [Image.effect_noise((W, H), 5)] * 3)
    wall = ImageChops.add(wall, grain, 1, -128)
    wall.save(out / "background.jpg", quality=95)

    # pill kaca; tepi 9-slice (12 px) digambar GRUB di luar kotak item
    box("select", out, (255, 255, 255, 22), 12, rim=(255, 255, 255, 64))

    # font GRUB dibuat dari font sistem; hanya huruf Latin supaya berkasnya kecil
    for name, (src, family, size) in FONTS.items():
        subprocess.run(["grub-mkfont", "-s", str(size), "-n", family, "-r", "0x20-0x7E,0xA0-0x17F,0x2018-0x2026",
                        "-o", str(out / name), str(APPLE / src)], check=True, stderr=subprocess.DEVNULL)

    (out / "theme.txt").write_text(f"""# Dibuat otomatis oleh caelestia-grub-theme, jangan diedit manual
title-text: ""
desktop-image: "background.jpg"
desktop-image-scale-method: "crop"
desktop-color: "{hexc('surface')}"
terminal-font: "Caelestia Mono Regular 18"
message-font: "Caelestia Mono Regular 18"
message-color: "{hexc('onSurfaceVariant')}"

+ label {{
    top = 30%-20
    left = 50%-300
    width = 600
    align = "left"
    text = "Which system today, sir?"
    font = "Caelestia Serif Regular 40"
    color = "{hexc('onSurface')}"
}}

+ boot_menu {{
    left = 50%-300
    top = 30%+64
    width = 600
    height = 230
    item_font = "Caelestia Sans Regular 20"
    selected_item_font = "Caelestia Sans Medium Regular 20"
    item_color = "{hexc('onSurfaceVariant')}"
    selected_item_color = "{hexc('onSurface')}"
    item_height = 32
    item_padding = 10
    item_spacing = 22
    icon_width = 0
    icon_height = 0
    item_icon_space = 0
    selected_item_pixmap_style = "select_*.png"
    scrollbar = false
}}

+ label {{
    id = "__timeout__"
    top = 30%+316
    left = 50%-300
    width = 600
    align = "left"
    text = "Starting automatically in %d seconds"
    font = "Caelestia Sans Regular 16"
    color = "{hexc('onSurfaceVariant')}"
}}

+ label {{
    top = 100%-72
    left = 50%-300
    width = 600
    align = "left"
    text = "Enter to start, arrow keys to choose, E to edit, C for the command line"
    font = "Caelestia Sans Regular 16"
    color = "{hexc('outline')}"
}}
""")


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--render":
        render(Path(sys.argv[2]))
        return
    if os.geteuid() != 0 or not os.environ.get("SUDO_USER"):
        sys.exit("Jalankan dengan sudo: sudo caelestia-grub-theme")
    user = os.environ["SUDO_USER"]
    pw = pwd.getpwnam(user)
    tmp = Path(tempfile.mkdtemp(prefix="caelestia-grub-"))
    try:
        os.chown(tmp, pw.pw_uid, pw.pw_gid)
        subprocess.run(["sudo", "-H", "-u", user, sys.executable, os.path.abspath(__file__), "--render", str(tmp)], check=True)
        DEST.mkdir(parents=True, exist_ok=True)
        for name in OUTPUTS:
            src = tmp / name
            if src.is_symlink() or not src.is_file() or src.stat().st_size > MAX_BYTES:
                sys.exit(f"hasil tidak valid: {name}")
            shutil.copyfile(src, DEST / name)
            os.chmod(DEST / name, 0o644)
        for old in DEST.iterdir():
            if old.name not in OUTPUTS and old.is_file():
                old.unlink()
        print(f"Tema GRUB diperbarui: {DEST}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    main()
