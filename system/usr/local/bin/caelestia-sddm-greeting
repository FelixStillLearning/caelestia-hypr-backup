#!/usr/bin/env python3
"""Ganti tulisan sambutan besar di tema login caelestia-sddm (Locklike)
menjadi salam "Welcome back, sir." serif miring dan garis suara.
Dijalankan otomatis oleh pacman hook setelah tema di-update.
Pemakaian: caelestia-sddm-greeting [path Greeting.qml]"""
import re
import sys
from pathlib import Path

path = Path(sys.argv[1] if len(sys.argv) > 1 else "/usr/share/sddm/themes/caelestia/components/Greeting.qml")
MARK = "// patched: welcome-back-sir"

NEW = MARK + """
    // Salam: kalimat serif miring, garis suara yang bergetar sekali lalu tenang,
    // tanpa teks tambahan, di atas kaca dengan tepi tipis.
    Item {
        id: welcomeTextRect

        width: welcomeText.width + 180
        height: welcomeText.height + 110
        anchors.centerIn: parent

        Rectangle {  // tepi kaca di atas kartu buram
            anchors.centerIn: parent
            width: parent.width + 30
            height: parent.height + 30
            radius: root.mainCardRadius
            color: "transparent"
            border.width: 1
            border.color: Qt.rgba(1, 1, 1, 0.16)
            opacity: root.firstInput ? 1 : 0
        }

        Column {
            id: welcomeText

            anchors.centerIn: parent
            spacing: 22
            opacity: root.firstInput ? 1 : 0

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                renderType: Text.QtRendering
                text: "Welcome back, sir."
                font.family: "New York Large"
                font.italic: true
                font.pixelSize: 64
                color: config.text
            }

            Canvas {
                id: voiceLine

                property real amp: 1
                property real phase: 0

                anchors.horizontalCenter: parent.horizontalCenter
                width: 220
                height: 22
                onAmpChanged: requestPaint()
                onPaint: {
                    const g = getContext("2d");
                    g.reset();
                    const mid = height / 2;
                    g.lineCap = "round";
                    g.lineWidth = 2;
                    g.strokeStyle = config.accent || config.primary;
                    g.beginPath();
                    for (let x = 0; x <= width; x += 2) {
                        const taper = Math.sin(Math.PI * x / width);
                        const y = mid + Math.sin(x * 0.07 + phase) * (0.55 + 0.45 * Math.sin(x * 0.02 - phase * 0.4))
                            * amp * (mid - 2) * taper;
                        x === 0 ? g.moveTo(x, y) : g.lineTo(x, y);
                    }
                    g.stroke();
                }

                // satu momen gerak: garis bergetar seperti baru selesai bicara, lalu diam
                ParallelAnimation {
                    running: root.firstInput
                    NumberAnimation { target: voiceLine; property: "amp"; from: 1; to: 0; duration: 1800; easing.type: Easing.OutCubic }
                    NumberAnimation { target: voiceLine; property: "phase"; from: 0; to: 14; duration: 1800 }
                }
            }

        }

        PropertyAnimation {
            target: welcomeTextRect
            property: "scale"
            from: 0.94
            to: 1
            duration: 500
            easing.type: Easing.OutCubic
            running: root.firstInput ? true : false
        }
    }
}
"""

src = path.read_text()
if src.endswith(NEW):
    sys.exit(0)
if MARK in src:  # versi patch lama: ganti mulai dari penanda
    start = src.index("    " + MARK)
else:  # blok asli: dari "Item {  id: welcomeTextRect" sampai akhir file
    m = re.search(r"\n    Item \{\s*\n\s*id: welcomeTextRect\b", src)
    if not m:
        sys.exit(f"{path}: blok welcomeTextRect tidak ditemukan, tema mungkin berubah; patch dilewati")
    start = m.start() + 1
path.write_text(src[:start] + "    " + NEW)
print(f"patched {path}")
