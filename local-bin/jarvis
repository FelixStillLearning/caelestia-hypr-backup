    if cmd == "say" and len(sys.argv) > 2:
        say(" ".join(sys.argv[2:]))
    elif cmd == "done" and len(sys.argv) > 3:
        done(sys.argv[2], sys.argv[3], " ".join(sys.argv[4:]))
    elif cmd in ("greet", "brief", "watch", "battery", "listen", "ask"):
        {"greet": greet, "brief": brief, "watch": watch, "battery": watch, "listen": listen, "ask": ask}[cmd]()
    else:
        sys.exit(__doc__)
