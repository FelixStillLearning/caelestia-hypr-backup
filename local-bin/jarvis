import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
import wave
from datetime import date, datetime, timezone
from pathlib import Path

HOME = Path.home()
VENV = HOME / ".local/share/piper/venv"
PIPER = VENV / "bin/piper"
VOICE = HOME / ".local/share/piper/voices/jarvis-high.onnx"
CONFIG = HOME / ".config/jarvis/config.json"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "jarvis"
FX = "highpass=f=120,aecho=0.8:0.6:40|70:0.25|0.15,volume=1.2"
PS = Path("/sys/class/power_supply")
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
SPEAKING = RUNTIME / "jarvis-speaking"
LISTEN_PID = RUNTIME / "jarvis-listen.pid"
LISTEN_OFF = STATE / "listen-off"             # ada = pendengaran dimatikan manual (Super+Alt+J)
LOW = (20, 10, 5)            # persen baterai laptop, masing-masing sekali per sesi tidak dicas
PHONE_LOW = 15               # persen baterai HP
QUIET = (22, 7)              # jam tenang: kabar non-darurat tidak diucapkan
TEMP_MAX = 90                # derajat C, CPU (k10temp)
RAM_MIN = 0.07
DISK_MIN = 0.10
COOLDOWN = 30 * 60           # detik antar peringatan sistem yang sama
WAKE_THRESHOLD = 0.4         # skor openWakeWord "hey jarvis" (lihat "near miss" di listen.log untuk menyetel)
MIC_GAIN = 3.0               # penguatan mic khusus Jarvis (mic laptop ini pelan)
FOLLOW_UP_WAIT = 6           # detik menunggu balasanmu setelah Jarvis menjawab
HISTORY_RESET = 10 * 60      # konteks obrolan dilupakan setelah 10 menit tidak ngobrol
WHISPER_MODEL = "small"      # multibahasa, cukup akurat untuk bahasa Indonesia
# kosakata yang sering diucapkan, supaya Whisper mengeja nama aplikasi dengan benar
WHISPER_HINT = ("Jarvis, buka Discord, Spotify, Obsidian, Zen, VS Code, terminal. "
                "Lagu berikutnya, putar lagu, kunci laptop, cari HP. Open Discord, next song.")
PERSONA = ("You are JARVIS, the calm, witty British AI butler of the user, whom you call 'sir'. "
           "He may speak Indonesian or English; always answer in English only, never in Indonesian, even if asked. Reply in at most two short "
           "spoken sentences, no lists, no markdown, no emoji. You are a voice assistant on his laptop with no "
           "tools or file access; never mention workspaces, terminals, tools, or files.")


def config():
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}


# ---------- suara ----------

_voice = None


def render(text, out):
    global _voice
    with tempfile.TemporaryDirectory() as d:
        raw = f"{d}/raw.wav"
        try:  # di venv: model dimuat sekali, jauh lebih cepat
            if _voice is None:
                from piper import PiperVoice
                _voice = PiperVoice.load(str(VOICE))
            with wave.open(raw, "wb") as w:
                _voice.synthesize_wav(text, w)
        except ImportError:
            subprocess.run([PIPER, "-m", VOICE, "-f", raw], input=text.encode(), check=True, stderr=subprocess.DEVNULL)
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", raw, "-af", FX, out], check=True)


def envelope(wav):
    """Amplitudo per 50 ms (0..1) untuk orb di poni."""
    with wave.open(str(wav)) as w:
        rate, frames = w.getframerate(), w.readframes(w.getnframes())
    pcm = array.array("h", frames)
    step = rate // 20
    rms = [(sum(x * x for x in pcm[i:i + step:4]) / max(1, len(pcm[i:i + step:4]))) ** 0.5
           for i in range(0, len(pcm), step)]
    peak = max(rms or [1]) or 1
    return [round(r / peak, 2) for r in rms], len(pcm) * 1000 // rate


def island(*args):
    subprocess.run(["qs", "-c", "jarvis-island", "ipc", "call", "island", *map(str, args)],
                   capture_output=True, timeout=3)


def play(wav, text=""):
    # kunci supaya dua ucapan tidak tumpang tindih; penanda SPEAKING membuat pendengar tidak salah dengar
    with open(RUNTIME / "jarvis.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        SPEAKING.touch()
        try:
            if text:
                env, ms = envelope(wav)
                island("speak", text, ",".join(map(str, env)), ms)
            subprocess.run(["pw-play", str(wav)], check=False)
        finally:
            SPEAKING.unlink(missing_ok=True)


def say(text):
    with tempfile.TemporaryDirectory() as d:
        render(text, f"{d}/out.wav")
        play(f"{d}/out.wav", text)


def say_async(text):
    threading.Thread(target=say, args=(text,), daemon=True).start()


def run(*cmd, timeout=10):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def shell(target, fn, *args):
    return run("qs", "-c", "caelestia", "ipc", "call", target, fn, *args)


def quiet():
    h = time.localtime().tm_hour
    return h >= QUIET[0] or h < QUIET[1] or shell("notifs", "isDndEnabled") == "true"


# ---------- info ----------

def battery():
    return int(read(PS / "BAT0/capacity") or 0), read(PS / "ACAD/online") == "1"


def part_of_day():
    h = time.localtime().tm_hour
    return "morning" if 4 <= h < 12 else "afternoon" if 12 <= h < 18 else "evening"


def spoken_time(t):
    hour = t.tm_hour % 12 or 12
    ampm = "AM" if t.tm_hour < 12 else "PM"
    if t.tm_min == 0:
        return f"{hour} {ampm}"
    return f"{hour} {t.tm_min:02d} {ampm}" if t.tm_min >= 10 else f"{hour} oh {t.tm_min} {ampm}"


def weather():
    city = config().get("city", "")
    try:
        with urllib.request.urlopen(f"https://wttr.in/{urllib.request.quote(city)}?format=j1", timeout=4) as r:
            cur = json.load(r)["current_condition"][0]
        return f"It is {cur['temp_C']} degrees outside, {cur['weatherDesc'][0]['value'].strip().lower()}."
    except Exception:
        return ""


def now_playing():
    names = run("busctl", "--user", "--list", "--no-legend").split()
    for name in (n for n in names if n.startswith("org.mpris.MediaPlayer2.")):
        prop = lambda p: run("busctl", "--user", "-j", "get-property", name, "/org/mpris/MediaPlayer2",
                             "org.mpris.MediaPlayer2.Player", p)
        try:
            if json.loads(prop("PlaybackStatus"))["data"] != "Playing":
                continue
            meta = json.loads(prop("Metadata"))["data"]
            title = meta["xesam:title"]["data"]
            artist = ", ".join(meta.get("xesam:artist", {}).get("data", []))
        except (ValueError, KeyError):
            continue
        return f"Now playing: {title}" + (f", by {artist}." if artist else ".")
    return ""


def todoist_today():
    token = config().get("todoist_token")
    if not token:
        return ""
    req = urllib.request.Request("https://api.todoist.com/api/v1/tasks/filter?query=today%20%7C%20overdue",
                                 headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            data = json.load(r)
        tasks = [t["content"] for t in data.get("results", data if isinstance(data, list) else [])]
    except Exception:
        return ""
    if not tasks:
        return "Your task list is clear for today."
    first = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", tasks[0])  # buang link markdown
    return f"You have {len(tasks)} task{'s' if len(tasks) > 1 else ''} today, starting with {first}."


def ics_events_today(ics):
    """Acara hari ini dari file iCal. ponytail: acara berulang (RRULE) tidak dihitung."""
    today = date.today().strftime("%Y%m%d")
    events, cur = [], None
    for line in ics.replace("\r\n ", "").splitlines():
        if line == "BEGIN:VEVENT":
            cur = {}
        elif line == "END:VEVENT" and cur is not None:
            if cur.get("start", "").startswith(today):
                events.append(cur)
            cur = None
        elif cur is not None and ":" in line:
            key, val = line.split(":", 1)
            if key.startswith("DTSTART"):
                if val.endswith("Z"):  # UTC -> waktu lokal
                    val = datetime.strptime(val, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc) \
                        .astimezone().strftime("%Y%m%dT%H%M%S")
                cur["start"] = val
            elif key == "SUMMARY":
                cur["title"] = val.replace("\\,", ",")
    return sorted(events, key=lambda e: e["start"])


def calendar_today():
    url = config().get("calendar_ics_url")
    if not url:
        return ""
    try:
        with urllib.request.urlopen(url, timeout=6) as r:
            events = ics_events_today(r.read().decode(errors="replace"))
    except Exception:
        return ""
    if not events:
        return "Your calendar is free today."
    e = events[0]
    when = ""
    if "T" in e["start"]:
        h, m = int(e["start"][9:11]), int(e["start"][11:13])
        when = " at " + spoken_time(time.struct_time((2000, 1, 1, h, m, 0, 0, 1, 0)))
    more = f", and {len(events) - 1} more after that" if len(events) > 1 else ""
    return f"Your first event is {e.get('title', 'untitled')}{when}{more}."


def thesis_today():
    cfg = config()
    parts = []
    vault = cfg.get("thesis_dir")
    if vault and Path(vault).is_dir():
        top = run("git", "-C", vault, "rev-parse", "--show-toplevel")
        if top:
            base = run("git", "-C", top, "rev-list", "-1", "--before=midnight", "HEAD") or \
                run("git", "-C", top, "rev-list", "--max-parents=0", "HEAD").splitlines()[0]
            diff = run("git", "-C", top, "diff", "--word-diff=porcelain", base, "--", vault)
            words = sum(len(l[1:].split()) for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++"))
            if words:
                parts.append(f"You wrote {words} words on your thesis today.")
    parts.append(seminar_countdown())
    return " ".join(p for p in parts if p)


def seminar_countdown():
    try:
        days = (date.fromisoformat(config().get("seminar_date", "")) - date.today()).days
    except ValueError:
        return ""
    if days > 0:
        return f"{days} day{'s' if days > 1 else ''} until your seminar."
    return "Your seminar is today. Good luck, sir." if days == 0 else ""


def greet():
    STATE.mkdir(parents=True, exist_ok=True)
    stamp = STATE / "last-greet"
    first_today = read(stamp) != date.today().isoformat()
    stamp.write_text(date.today().isoformat())
    if not first_today:
        say(f"Good {part_of_day()}, sir. Welcome back.")
        return
    lines = [f"Good {part_of_day()}, sir. All systems are online.", weather(), todoist_today(),
             calendar_today(), seminar_countdown()]
    say(" ".join(l for l in lines if l))


def brief():
    pct, plugged = battery()
    lines = [
        f"Good {part_of_day()}, sir. It is {spoken_time(time.localtime())}.",
        weather(),
        f"Battery at {pct} percent{', charging' if plugged else ''}.",
        now_playing(),
        thesis_today(),
    ]
    say(" ".join(l for l in lines if l))


def done(status, pid, cmd):
    """Perintah terminal lama selesai: bicara hanya kalau terminalnya sedang tidak dilihat."""
    try:
        active = json.loads(run("hyprctl", "activewindow", "-j") or "{}").get("pid")
    except ValueError:
        active = None
    p = int(pid)
    while p > 1:  # naik dari fish ke terminal yang menjalankannya
        if p == active:
            return
        p = int(read(f"/proc/{p}/stat").rsplit(")", 1)[-1].split()[1] or 1)
    name = cmd.split()[0].split("/")[-1] if cmd.strip() else "command"
    if name in ("sudo", "doas") and len(cmd.split()) > 1:
        name = cmd.split()[1]
    say(f"The {name} command has finished, sir." if status == "0" else f"The {name} command has failed, sir.")


# ---------- daemon pemantau ----------

def cpu_temp():
    for h in Path("/sys/class/hwmon").iterdir():
        if read(h / "name") == "k10temp":
            return int(read(h / "temp1_input") or 0) // 1000
    return 0


def ram_free():
    info = dict(l.split(":", 1) for l in read("/proc/meminfo").splitlines())
    return int(info["MemAvailable"].split()[0]) / int(info["MemTotal"].split()[0])


def audio_out():
    try:
        sinks = json.loads(run("pactl", "-f", "json", "list", "sinks") or "[]")
    except ValueError:
        return ""
    default = run("pactl", "get-default-sink")
    for s in sinks:
        if s["name"] == default:
            port = s.get("active_port") or ""
            return "headphones" if "headphone" in port or "bluez" in default else "speakers"
    return ""


def bt_devices():
    out = run("bluetoothctl", "devices", "Connected")
    return {l.split(" ", 2)[2] for l in out.splitlines() if l.startswith("Device ") and len(l.split(" ", 2)) == 3}


def monitors():
    try:
        return len(json.loads(run("hyprctl", "monitors", "-j") or "[]"))
    except ValueError:
        return 0


def phone():
    """(id, nama) HP pertama yang tersambung lewat KDE Connect."""
    ids = run("kdeconnect-cli", "-a", "--id-name-only").splitlines()
    return tuple(ids[0].split(" ", 1)) if ids and " " in ids[0] else (None, None)


def phone_battery(dev):
    path = f"/modules/kdeconnect/devices/{dev}/battery"
    get = lambda p: run("busctl", "--user", "get-property", "org.kde.kdeconnect", path,
                        "org.kde.kdeconnect.device.battery", p).split()
    try:
        return int(get("charge")[1]), get("isCharging")[1] == "true"
    except (IndexError, ValueError):
        return None, None


def farewell_guard():
    """Tahan shutdown sebentar (inhibitor delay) supaya 'Goodbye' sempat diucapkan."""
    wav = RUNTIME / "jarvis-goodbye.wav"
    if not wav.exists():
        render("Goodbye, sir. Shutting down.", str(wav))
    inhibit = subprocess.Popen(["systemd-inhibit", "--what=shutdown", "--mode=delay", "--who=Jarvis",
                                "--why=Farewell", "sleep", "infinity"])
    mon = subprocess.Popen(["dbus-monitor", "--system", "type='signal',interface='org.freedesktop.login1.Manager',"
                            "member='PrepareForShutdown'"], stdout=subprocess.PIPE, text=True)
    for line in mon.stdout:
        if "boolean true" in line:
            play(str(wav))
            inhibit.kill()
            return


def classify(app, summary, body, entry):
    """Notifikasi penting -> kalimat (hanya pengirim, isi pesan tidak dibacakan)."""
    text = f"{app} {summary} {body} {entry}".lower()
    sender = re.sub(r"^\s*whatsapp\s*[:\-]\s*", "", summary, flags=re.I)
    sender = re.sub(r"\s*\(\d+ (messages|pesan)\)", "", sender, flags=re.I).strip()
    if "kde connect" in text or "kdeconnect" in text:
        if re.search(r"\b(incoming call|calling|panggilan masuk|memanggil)\b", text):
            return "call", f"Incoming call from {sender or 'an unknown number'}, sir."
        if re.search(r"\b(sms|messages?:)\b", text) and "whatsapp" not in text:
            return "sms", f"New text message from {sender}, sir."
    if "whatsapp" in text:
        return "msg", f"Message from {sender} on WhatsApp, sir."
    if app.lower() in ("equibop", "discord", "vesktop") or "equibop" in entry.lower():
        if " (#" in summary or "#" in summary:  # pesan server, bukan DM
            return None
        return "msg", f"Discord message from {summary.split(' (')[0]}, sir."
    if "mail.google.com" in text or "gmail" in text:
        return "msg", f"New email from {summary}, sir."
    return None


def notification_guard():
    mon = subprocess.Popen(["dbus-monitor", "--session",
                            "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"],
                           stdout=subprocess.PIPE, text=True)
    strings, in_call, depth = [], False, 0
    for line in mon.stdout:
        if line.startswith("method call") and "member=Notify" in line:
            if in_call:
                handle(strings)
            strings, in_call = [], True
            continue
        if not in_call:
            continue
        m = re.match(r'(\s*)string "(.*)"$', line.rstrip("\n"))
        if m:
            strings.append((len(m.group(1)), m.group(2)))
        elif line.startswith("   int32"):  # akhir argumen Notify
            handle(strings)
            in_call = False


def handle(strings):
    top = [s for indent, s in strings if indent == 3]
    if len(top) < 4:
        return
    app, _icon, summary, body = top[:4]
    nested = [s for indent, s in strings if indent > 3]
    entry = nested[nested.index("desktop-entry") + 1] if "desktop-entry" in nested[:-1] else ""
    hit = classify(app, summary, body, entry)
    if not hit:
        return
    kind, sentence = hit
    if kind == "call" or not quiet():
        say_async(sentence)


def watch():
    threading.Thread(target=farewell_guard, daemon=True).start()
    threading.Thread(target=notification_guard, daemon=True).start()
    pct, plugged = battery()
    warned = {x for x in LOW if pct <= x}  # jangan langsung bicara saat login
    last_alert = {}
    hot = 0
    out, bt, mons = audio_out(), bt_devices(), monitors()
    locked = shell("lock", "isLocked") == "true"
    chimed = time.localtime().tm_hour
    phone_warned, tick = False, 0

    def alert(key, text):
        if time.time() - last_alert.get(key, 0) > COOLDOWN:
            last_alert[key] = time.time()
            say_async(text)

    while True:
        time.sleep(5)
        tick += 1

        # baterai, charger, profil daya
        new_pct, new_plugged = battery()
        if new_plugged != plugged:
            run("powerprofilesctl", "set", "balanced" if new_plugged else "power-saver")
            say_async(f"Charger connected, sir. Battery at {new_pct} percent." if new_plugged
                      else f"Running on battery power, sir. {new_pct} percent remaining. Power saver engaged.")
            warned = set()
        elif not new_plugged:
            for x in LOW:
                if new_pct <= x and x not in warned:
                    warned |= {y for y in LOW if y >= x}
                    say_async(f"Battery at {new_pct} percent, sir. I suggest plugging in." if x > 5
                              else f"Battery critical at {new_pct} percent, sir. Shutdown is imminent.")
                    break
        pct, plugged = new_pct, new_plugged

        # suhu (harus panas 3 kali berturut-turut = 15 detik), RAM, disk
        hot = hot + 1 if cpu_temp() >= TEMP_MAX else 0
        if hot == 3:
            alert("temp", f"CPU temperature is at {cpu_temp()} degrees, sir. You may want to ease off.")
        if ram_free() < RAM_MIN:
            alert("ram", "Memory is almost full, sir. Consider closing a few applications.")
        du = shutil.disk_usage("/")
        if du.free / du.total < DISK_MIN:
            alert("disk", f"Disk space is down to {du.free * 100 // du.total} percent, sir.")

        # monitor, headphone, Bluetooth
        n = monitors()
        if n != mons and n:
            say_async("External display connected, sir." if n > mons else "External display disconnected, sir.")
            mons = n
        o = audio_out()
        if o and o != out:
            say_async("Headphones connected, sir." if o == "headphones" else "Switched to speakers, sir.")
            out = o
        b = bt_devices()
        for d in sorted(b - bt):
            say_async(f"{d} connected, sir.")
        bt = b

        # baterai HP (KDE Connect), tiap menit
        if tick % 12 == 0:
            dev, name = phone()
            if dev:
                charge, charging = phone_battery(dev)
                if charge is not None and charge <= PHONE_LOW and not charging and not phone_warned:
                    phone_warned = True
                    say_async(f"Your phone battery is at {charge} percent, sir.")
                elif charging or (charge or 0) > PHONE_LOW:
                    phone_warned = False

        # lock / unlock
        now_locked = shell("lock", "isLocked") == "true"
        if now_locked != locked:
            say_async("Securing the workstation, sir." if now_locked else "Welcome back, sir.")
            locked = now_locked

        # info jam tiap jam
        t = time.localtime()
        if t.tm_min == 0 and t.tm_hour != chimed:
            chimed = t.tm_hour
            if not quiet() and not locked:
                say_async(f"It is {spoken_time(t)}, sir.")


# ---------- perintah suara ----------

APPS = {  # kata kunci -> perintah
    r"discord|di ?skor|diskor|disc ord": ["caelestia", "toggle", "communication"],
    r"spotify|music|musik|lagu": ["caelestia", "toggle", "music"],
    r"browser|zen|internet": ["zen-browser"],
    r"vs ?code|visual studio|code|editor": ["code"],
    r"obsidian|notes?|catatan": ["obsidian"],
    r"terminal": ["foot"],
    r"files?|file manager|folder": ["thunar"],
    r"calculator|kalkulator": ["gnome-calculator"],
}


def command(text):
    """Perintah tetap dua bahasa. Mengembalikan kalimat balasan, atau None kalau bukan perintah."""
    t = text.lower().strip(" .!?")
    t = re.sub(r"^(hey|hai|halo)?\s*jarvis[,.]?\s*", "", t)
    if not t:
        return "Yes, sir?"
    if re.search(r"\b(never ?mind|cancel|batal|(nggak|gak|ga|tidak) jadi)\b", t):
        return "Very well, sir."
    if re.search(r"\b(find|cari|where is|di ?mana)\b.*\b(phone|hp|handphone|ponsel)\b", t):
        dev, _ = phone()
        if not dev:
            return "I cannot reach your phone, sir."
        run("kdeconnect-cli", "-d", dev, "--ring")
        return "Ringing your phone now, sir."
    m = re.search(r"\b(open|launch|start|buka|bukain|jalankan)\b\s+(.+)", t)
    if m:
        for pat, cmd in APPS.items():
            if re.search(rf"\b({pat})\b", m.group(2)):
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                return "Right away, sir."
    if re.search(r"\b(lock|kunci)\b", t):
        threading.Timer(2.5, shell, ("lock", "lock")).start()
        return "Locking the workstation, sir."
    if re.search(r"\b(next|skip|berikutnya|selanjutnya|ganti lagu)\b", t):
        shell("mpris", "next")
        return "Next track, sir."
    if re.search(r"\b(previous|sebelumnya)\b", t):
        shell("mpris", "previous")
        return "Previous track, sir."
    if re.search(r"\b(pause|stop|jeda|hentikan)\b", t):
        shell("mpris", "pause")
        return "Paused, sir."
    if re.search(r"\b(play|resume|putar|puterin|lanjutkan)\b", t):
        shell("mpris", "play")
        return "Playing, sir."
    if re.search(r"\b(volume up|louder|keraskan|kerasin|naikkan|naikin)\b", t):
        run("wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", "10%+")
        return "Volume up, sir."
    if re.search(r"\b(volume down|quieter|kecilkan|kecilin|pelankan|turunkan|turunin)\b", t):
        run("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "10%-")
        return "Volume down, sir."
    if re.search(r"\b(what time|the time|jam berapa)\b", t):
        return f"It is {spoken_time(time.localtime())}, sir."
    if re.search(r"\b(brief|briefing|status|report|laporan|ringkasan)\b", t):
        threading.Thread(target=brief, daemon=True).start()
        return ""
    return None


def claude_reply(text, history):
    exe = shutil.which("claude") or str(HOME / ".local/bin/claude")
    convo = "".join(f"User: {u}\nJARVIS: {a}\n" for u, a in history[-8:])
    now = datetime.now().strftime("%A %d %B %Y, %H:%M")
    prompt = f"Current time: {now}.\n{convo}User: {text}\nJARVIS:"
    # folder sendiri + sesi tidak disimpan: tidak membaca memori proyek kerja dan tidak muncul di daftar sesi
    room = STATE / "claude"
    room.mkdir(parents=True, exist_ok=True)
    nomcp = room / "no-mcp.json"
    if not nomcp.exists():
        nomcp.write_text('{"mcpServers": {}}')
    try:
        out = subprocess.run([exe, "-p", "--model", "haiku", "--tools", "", "--no-session-persistence",
                              "--disable-slash-commands", "--strict-mcp-config", "--mcp-config", str(nomcp),
                              "--setting-sources", "project,local",  # tanpa plugin/hook dari pengaturan user
                              "--system-prompt", PERSONA, prompt],
                             cwd=room, capture_output=True, text=True, timeout=45).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    return out.replace("*", "").strip() or "I am afraid my connection to the cloud failed, sir."


def log(msg):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "listen.log", "a") as f:
        f.write(time.strftime("%H:%M:%S ") + msg + "\n")


def listen():
    import numpy as np
    from faster_whisper import WhisperModel
    from openwakeword.model import Model
    from openwakeword.vad import VAD

    LISTEN_PID.write_text(str(os.getpid()))
    (STATE / "listen.log").write_text("")  # log baru tiap daemon mulai
    wake = Model(wakeword_models=["hey_jarvis"], inference_framework="onnx")
    vad = VAD()
    stt = WhisperModel(WHISPER_MODEL, device="cpu", compute_type="int8", cpu_threads=8)
    cues = {}
    for name, text in (("yes", "Yes, sir?"), ("moment", "One moment, sir."), ("missed", "I did not catch that, sir.")):
        cues[name] = RUNTIME / f"jarvis-{name}.wav"
        if not cues[name].exists():
            render(text, str(cues[name]))
    render("ready", str(RUNTIME / "jarvis-warmup.wav"))  # muat model suara sekarang, bukan saat menjawab
    manual = threading.Event()
    signal.signal(signal.SIGUSR1, lambda *_: manual.set())
    history = []
    last_talk = 0.0
    log("ready")

    rec = None
    CHUNK = 1280  # 80 ms

    def open_mic():
        nonlocal rec
        if rec is None:
            rec = subprocess.Popen(["parec", "--raw", "--rate=16000", "--channels=1", "--format=s16le",
                                    "--latency-msec=80"], stdout=subprocess.PIPE)

    def close_mic():
        nonlocal rec
        if rec is not None:
            rec.kill()
            rec.wait()
            rec = None

    def chunk():
        # mic laptop pelan: dikuatkan di sini saja, volume mic untuk aplikasi lain tidak berubah
        a = np.frombuffer(rec.stdout.read(CHUNK * 2), dtype=np.int16).astype(np.float32) * MIC_GAIN
        return np.clip(a, -32768, 32767).astype(np.int16)

    def record_utterance(wait=4):
        """Rekam sampai 0.7 detik hening setelah bicara (VAD Silero), maksimal 8 detik.
        None kalau tidak ada suara selama `wait` detik."""
        vad.reset_states()
        frames, spoke, silent = [], False, 0
        for i in range(int((wait + 8) * 12.5)):
            a = chunk()
            frames.append(a)
            if vad.predict(a, frame_size=640) > 0.5:
                spoke, silent = True, 0
            elif spoke:
                silent += 1
                if silent >= 9:
                    break
            elif i > wait * 12.5:  # belum bicara sama sekali
                return None
            if spoke and len(frames) > 100:  # sudah 8 detik bicara
                break
        return np.concatenate(frames).astype(np.float32) / 32768

    def transcribe(audio):
        # bahasa dikunci ke Indonesia: tidak salah tebak (misalnya Rusia), kalimat Inggris tetap terbaca utuh
        segs, _ = stt.transcribe(audio, language="id", beam_size=1, initial_prompt=WHISPER_HINT,
                                 condition_on_previous_text=False)
        return " ".join(x.text for x in segs).strip()

    paused, checked, shown, pushed, near = None, 0.0, "", 0.0, 0.0
    while True:
        if time.monotonic() - checked > 1:  # cek alasan berhenti tiap detik
            checked = time.monotonic()
            paused = pause_reason(rec.pid if rec else None)
            state = "false" if paused else "true"
            if state != shown or time.monotonic() - pushed > 10:  # poni bisa baru dijalankan ulang
                island("mic", state)
                shown, pushed = state, time.monotonic()
        if paused and not manual.is_set():
            close_mic()
            manual.wait(1)
            continue
        open_mic()
        a = chunk()
        if len(a) < CHUNK:
            close_mic()
            time.sleep(1)
            continue
        if SPEAKING.exists():
            wake.reset()
            continue
        score = 1.0 if manual.is_set() else wake.predict(a).get("hey_jarvis", 0)
        if score <= WAKE_THRESHOLD:
            if score > 0.15 and time.monotonic() - near > 2:  # hampir terpanggil: dicatat untuk menyetel ambang
                near = time.monotonic()
                log(f"near miss score={score:.2f}")
            continue
        manual.clear()
        wake.reset()
        log(f"wake score={score:.2f}")
        if time.monotonic() - last_talk > HISTORY_RESET:  # lama tidak ngobrol: mulai topik baru
            history.clear()
        close_mic()  # audio yang tertampung selama Jarvis bicara/berpikir ikut terbuang
        play(str(cues["yes"]), "Yes, sir?")
        # percakapan: setelah Jarvis menjawab, dia tetap mendengar tanpa "Hey Jarvis" sampai kamu diam
        follow_up = False
        while True:
            open_mic()
            island("hear")
            t0 = time.monotonic()
            audio = record_utterance(wait=FOLLOW_UP_WAIT if follow_up else 4)
            if audio is None:
                log("conversation ended" if follow_up else "no speech")
                island("idle")
                break
            close_mic()
            island("think")
            t1 = time.monotonic()
            text = transcribe(audio)
            log(f"heard {len(audio) / 16000:.1f}s (rec {t1 - t0:.1f}s, stt {time.monotonic() - t1:.1f}s) {text!r}")
            if not text:
                play(str(cues["missed"]), "I did not catch that, sir.")
                follow_up = True
                continue
            if ending(text):
                say("You are welcome, sir.")
                last_talk = time.monotonic()
                break
            reply = command(text)
            if reply is None:
                filler = threading.Thread(target=play, args=(str(cues["moment"]), "One moment, sir."))
                filler.start()
                t2 = time.monotonic()
                reply = claude_reply(text, history)
                history.append((text, reply))
                log(f"claude {time.monotonic() - t2:.1f}s: {reply!r}")
                filler.join()
                chatting = True
            else:
                log(f"command: {reply!r}")
                chatting = reply == "Yes, sir?"  # hanya dipanggil namanya: tunggu kalimat berikutnya
            if reply and reply != "Yes, sir?":
                say(reply)
            last_talk = time.monotonic()
            if not chatting:  # perintah biasa (buka aplikasi, lagu, ...) selesai di sini
                island("idle")
                break
            follow_up = True


def ending(text):
    """Kalimat pendek penutup obrolan, misalnya "makasih Jarvis" atau "udah itu aja"."""
    if "?" in text or re.search(r"\b(apa|berapa|gimana|bagaimana|kenapa|siapa|kapan|mana|what|how|why|who|when)\b", text.lower()):
        return False
    return len(text.split()) <= 4 and bool(
        re.search(r"\b(thank(s| you)|that'?s all|terima ?kasih|makasih|udah|sudah|cukup|itu aja)\b", text.lower()))


def pause_reason(own_pid):
    """Kenapa pendengaran harus mati: dimatikan manual atau aplikasi lain memakai mic (call)."""
    if LISTEN_OFF.exists():
        return "off"
    try:
        sources = {str(x["index"]): x["name"] for x in json.loads(run("pactl", "-f", "json", "list", "sources") or "[]")}
        outputs = json.loads(run("pactl", "-f", "json", "list", "source-outputs") or "[]")
    except ValueError:
        return None
    for o in outputs:
        pid = o["properties"].get("application.process.id")
        if not sources.get(str(o["source"]), ".monitor").endswith(".monitor") and str(pid) != str(own_pid):
            return "call"
    return None


def toggle():
    STATE.mkdir(parents=True, exist_ok=True)
    if LISTEN_OFF.exists():
        LISTEN_OFF.unlink()
        say("Listening enabled, sir.")
    else:
        LISTEN_OFF.touch()
        say("Listening disabled, sir.")


def ask():
    try:
        os.kill(int(read(LISTEN_PID)), signal.SIGUSR1)
    except (ValueError, OSError):
        say("My listening module is offline, sir.")


