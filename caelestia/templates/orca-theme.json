{
  "schemaVersion": 1,
  "base": "{{ mode }}",
  "tokens": {
    "--background": "#{{ surface.hex }}",
    "--editor-surface": "#{{ surface.hex }}",
    "--foreground": "#{{ onSurface.hex }}",
    "--card": "#{{ surfaceContainerLow.hex }}",
    "--card-foreground": "#{{ onSurface.hex }}",
    "--popover": "#{{ surfaceContainerHigh.hex }}",
    "--popover-foreground": "#{{ onSurface.hex }}",
    "--primary": "#{{ primary.hex }}",
    "--primary-foreground": "#{{ onPrimary.hex }}",
    "--secondary": "#{{ secondaryContainer.hex }}",
    "--secondary-foreground": "#{{ onSecondaryContainer.hex }}",
    "--muted": "#{{ surfaceContainer.hex }}",
    "--muted-foreground": "#{{ onSurfaceVariant.hex }}",
    "--accent": "#{{ surfaceContainerHighest.hex }}",
    "--accent-foreground": "#{{ onSurface.hex }}",
    "--border": "#{{ outlineVariant.hex }}",
    "--input": "#{{ outlineVariant.hex }}",
    "--ring": "#{{ primary.hex }}",
    "--chart-1": "#{{ primary.hex }}",
    "--chart-2": "#{{ secondary.hex }}",
    "--chart-3": "#{{ tertiary.hex }}",
    "--chart-4": "#{{ blue.hex }}",
    "--chart-5": "#{{ peach.hex }}",
    "--sidebar": "#{{ surfaceContainerLow.hex }}",
    "--sidebar-foreground": "#{{ onSurface.hex }}",
    "--sidebar-primary": "#{{ primary.hex }}",
    "--sidebar-primary-foreground": "#{{ onPrimary.hex }}",
    "--sidebar-accent": "#{{ surfaceContainerHigh.hex }}",
    "--sidebar-accent-foreground": "#{{ onSurface.hex }}",
    "--sidebar-border": "#{{ outlineVariant.hex }}",
    "--sidebar-ring": "#{{ primary.hex }}",
    "--worktree-sidebar": "#{{ surfaceContainerLow.hex }}",
    "--worktree-sidebar-foreground": "#{{ onSurface.hex }}",
    "--worktree-sidebar-accent": "#{{ surfaceContainerHigh.hex }}",
    "--worktree-sidebar-accent-foreground": "#{{ onSurface.hex }}",
    "--worktree-sidebar-border": "#{{ outlineVariant.hex }}",
    "--worktree-sidebar-ring": "#{{ primary.hex }}",
    "--worktree-sidebar-active": "#{{ primaryContainer.hex }}",
    "--worktree-sidebar-active-border": "#{{ primary.hex }}",
    "--tab-bar": "#{{ surfaceContainer.hex }}",
    "--tab-active": "#{{ surface.hex }}",
    "--tab-active-foreground": "#{{ onSurface.hex }}",
    "--tab-active-indicator": "#{{ primary.hex }}",
    "--tab-inactive": "#{{ surfaceContainer.hex }}",
    "--tab-inactive-foreground": "#{{ onSurfaceVariant.hex }}",
    "--text-link": "#{{ blue.hex }}",
    "--diff-added": "#{{ green.hex }}",
    "--diff-removed": "#{{ red.hex }}",
    "--git-decoration-added": "#{{ green.hex }}",
    "--git-decoration-modified": "#{{ yellow.hex }}",
    "--git-decoration-deleted": "#{{ red.hex }}",
    "--git-decoration-renamed": "#{{ blue.hex }}",
    "--git-decoration-untracked": "#{{ teal.hex }}",
    "--git-decoration-ignored": "#{{ outline.hex }}"
  },
  "tokenColors": [
    { "scope": ["source", "variable", "meta.definition.variable"], "settings": { "foreground": "#{{ onSurface.hex }}" } },
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#{{ onSurfaceVariant.hex }}", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#{{ green.hex }}" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#{{ pink.hex }}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.constant"], "settings": { "foreground": "#{{ peach.hex }}" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#{{ mauve.hex }}" } },
    { "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator"], "settings": { "foreground": "#{{ teal.hex }}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#{{ blue.hex }}", "fontStyle": "italic" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "entity.name.namespace"], "settings": { "foreground": "#{{ yellow.hex }}", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "variable.other.enummember"], "settings": { "foreground": "#{{ teal.hex }}" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#{{ maroon.hex }}", "fontStyle": "italic" } },
    { "scope": ["variable.language", "support.function.builtin"], "settings": { "foreground": "#{{ red.hex }}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#{{ blue.hex }}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#{{ yellow.hex }}", "fontStyle": "italic" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#{{ peach.hex }}" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#{{ blue.hex }}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#{{ primary.hex }}", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#{{ green.hex }}" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#{{ blue.hex }}" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#{{ green.hex }}" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#{{ red.hex }}" } },
    { "scope": "invalid", "settings": { "foreground": "#{{ error.hex }}" } }
  ]
}
