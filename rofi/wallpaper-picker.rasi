/* Picker wallpaper (SUPER+W): kaca bergaya macOS Liquid Glass */
@import "colors.rasi"

configuration {
    modi:       "dmenu";
    show-icons: true;
    font:       "SF Pro Text 11";
}

* {
    background-color: transparent;
    text-color:       @on-surface;
}

window {
    location:         center;
    anchor:           center;
    width:            920px;
    border:           1px solid;
    border-color:     rgba(255, 255, 255, 16%);
    border-radius:    32px;
    padding:          22px;
    background-color: @glass;
}

mainbox {
    spacing:  16px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing:          12px;
    padding:          12px 20px;
    border-radius:    999px;
    background-color: @glass-card;
    border:           1px solid;
    border-color:     rgba(255, 255, 255, 12%);
    children:         [ "textbox-prompt-colon", "entry" ];
}
textbox-prompt-colon {
    expand:         false;
    str:            "search";
    font:           "Material Symbols Rounded 16";
    vertical-align: 0.5;
    text-color:     @on-surface-variant;
}
entry {
    font:              "SF Pro Text 12";
    vertical-align:    0.5;
    cursor:            text;
    placeholder:       "Search wallpapers...";
    placeholder-color: @on-surface-variant;
}

listview {
    columns:      3;
    lines:        2;
    spacing:      14px;
    cycle:        true;
    dynamic:      true;
    fixed-height: true;
    scrollbar:    false;
}

element {
    orientation:      vertical;
    spacing:          8px;
    padding:          12px;
    border:           1px solid;
    border-color:     rgba(255, 255, 255, 10%);
    border-radius:    26px;
    background-color: @glass-card;
    cursor:           pointer;
}
element selected.normal {
    background-color: @glass-hi;
    border-color:     @primary;
}
element-icon {
    size:             240px;
    horizontal-align: 0.5;
    cursor:           inherit;
}
element-text {
    font:             "SF Pro Text Medium 11";
    horizontal-align: 0.5;
    text-color:       @on-surface-variant;
    cursor:           inherit;
}
element selected.normal element-text {
    text-color:       @on-surface;
}
