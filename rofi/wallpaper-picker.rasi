/* Picker wallpaper (SUPER+W) bergaya Caelestia */
@import "colors.rasi"

configuration {
    modi:       "dmenu";
    show-icons: true;
    font:       "Rubik 10";
}

* {
    background-color: transparent;
    text-color:       @on-surface;
}

window {
    location:         center;
    anchor:           center;
    width:            1000px;
    border:           0px;
    border-radius:    28px;
    padding:          18px;
    background-color: @surface;
}

mainbox {
    spacing:  16px;
    children: [ "listview", "inputbar" ];
}

inputbar {
    spacing:          10px;
    padding:          12px 18px;
    border-radius:    999px;
    background-color: @surface-container-high;
    children:         [ "textbox-prompt-colon", "entry" ];
}
textbox-prompt-colon {
    expand:         false;
    str:            "search";
    font:           "Material Symbols Rounded 15";
    vertical-align: 0.5;
    text-color:     @on-surface-variant;
}
entry {
    font:              "Rubik 12";
    vertical-align:    0.5;
    cursor:            text;
    placeholder:       "Search wallpapers";
    placeholder-color: @on-surface-variant;
}

listview {
    columns:      3;
    lines:        2;
    spacing:      12px;
    cycle:        true;
    dynamic:      true;
    fixed-height: true;
    scrollbar:    false;
}

element {
    orientation:      vertical;
    spacing:          8px;
    padding:          10px;
    border:           2px solid;
    border-color:     transparent;
    border-radius:    20px;
    background-color: @surface-container;
    cursor:           pointer;
}
element selected.normal {
    background-color: @surface-container-highest;
    border-color:     @primary;
}
element-icon {
    size:             190px;
    horizontal-align: 0.5;
    cursor:           inherit;
}
element-text {
    horizontal-align: 0.5;
    text-color:       @on-surface-variant;
    cursor:           inherit;
}
element selected.normal element-text {
    text-color: @on-surface;
}
