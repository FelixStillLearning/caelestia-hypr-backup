/* Menu kecil bergaya launcher Caelestia (dipakai display-mode.sh & battery-mode.sh) */
configuration {
    font:       "SF Pro Text 12";
    show-icons: true;
}

@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @on-surface;
}

window {
    location:         center;
    anchor:           center;
    width:            440px;
    border:           1px solid;
    border-color:     rgba(255, 255, 255, 16%);
    border-radius:    32px;
    padding:          16px;
    background-color: @glass;
}

mainbox {
    spacing:  10px;
    children: [ "message", "listview" ];
}

message {
    padding: 6px 14px 2px 14px;
}
textbox {
    font:       "SF Pro Text Medium 13";
    text-color: @on-surface-variant;
}

listview {
    lines:        7;
    spacing:      6px;
    dynamic:      true;
    fixed-height: false;
    scrollbar:    false;
    cycle:        true;
}

element {
    spacing:          16px;
    padding:          12px 16px;
    border-radius:    18px;
    cursor:           pointer;
    background-color: transparent;
    border:           1px solid;
    border-color:     transparent;
}
element selected.normal,
element selected.active {
    background-color: @glass-hi;
    border-color:     rgba(255, 255, 255, 12%);
}
element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    cursor:         inherit;
}
element normal.active,
element selected.active {
    text-color: @primary;
}
element-icon {
    size:   28px;
    cursor: inherit;
}
